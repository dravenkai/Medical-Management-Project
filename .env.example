# ---------------------------------------------------------------------------
# Root env file for `docker compose`. Copy this to `.env` (same folder as
# docker-compose.yml) and fill in real values — .env is gitignored and is
# what actually gets read by docker-compose.yml's ${VAR} references.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS/Linux:          cp .env.example .env
# ---------------------------------------------------------------------------

# ===== MySQL (shared container, two databases inside it) ===================
# Dev-only setup: both apps connect as root using this one password. Fine
# behind the internal Docker network; don't reuse this password anywhere
# real.
MYSQL_ROOT_PASSWORD=changeme_root_pw
MYSQL_HUB_DB=azuremed_hub
MYSQL_BACKEND_DB=medical_project

# ===== azuremed-hub (Next.js frontend + API) ================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Browser-facing URL — leave as localhost:3000 for local Docker use.
NEXTAUTH_URL=http://localhost:3000

# Optional — Vertex AI endpoint for the medicine-detection route. Leave
# blank to leave that feature inert.
GOOGLE_AI_ENDPOINT=
GOOGLE_AI_API_KEY=

# Optional — reCAPTCHA v3 on login/register. Leave both blank to disable
# (no CAPTCHA shown, nothing blocked).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional — SMTP for the "forgot password" email. Leave blank and the app
# logs the reset link to the container console instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AzureMed Hub <no-reply@azuremedhub.com>"

# ===== Telegram bot <-> azuremed-hub shared secret ==========================
# Generate with: openssl rand -hex 32 — must be identical for both services,
# docker-compose.yml already wires the same value into both.
BOT_API_SECRET=generate-with-openssl-rand-hex-32
# From @BotFather.
BOT_TOKEN=your-telegram-bot-token
# Bot's @username, no leading @ — powers the "Need Help?" deep link.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# ===== backend (PHP API) =====================================================
APP_KEY=change-this-key
# Origins allowed to call the PHP API's CORS headers (comma-separated).
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# ===== Admin-Dashboard (Vite/React, build-time only) =========================
# Baked into the static bundle at build time — this runs in the browser, so
# it must be the HOST-mapped backend port, not the internal service name.
VITE_API_BASE_URL=http://localhost:8000
VITE_ADMIN_EMAIL=admin@medical.local
VITE_ADMIN_PASSWORD=admin123
